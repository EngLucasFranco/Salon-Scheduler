# Copie este arquivo para .env (desenvolvimento local) e preencha os valores reais.
# Em produção (Vercel), configure estas mesmas variáveis em Project Settings > Environment Variables.

# Desenvolvimento local: banco SQLite. Na Vercel, altere para mongodb.
DB_PROVIDER=sqlite
SQLITE_PATH=./data/agenda.sqlite

# Obrigatório apenas na Vercel, com DB_PROVIDER=mongodb.
MONGODB_URI=mongodb+srv://usuario:senha@cluster0.mongodb.net/salon-scheduler?retryWrites=true&w=majority

# Segredo usado para assinar os tokens JWT (use uma string longa e aleatória)
JWT_SECRET=troque_esta_chave_por_uma_bem_grande_e_aleatoria

# Tempo de expiração do token
JWT_EXPIRES_IN=7d

# Porta usada apenas em desenvolvimento local (a Vercel define a própria porta)
PORT=5000

# Origem(ns) permitida(s) para CORS, separadas por vírgula quando necessário.
# Local: http://localhost:5173
# Produção: https://seu-frontend.vercel.app
CORS_ORIGIN=http://localhost:5173

# Chave de convite usada para criar a conta de gestor (evita que qualquer um se registre como gestor)
MANAGER_INVITE_CODE=troque_este_codigo
